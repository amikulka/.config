{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "commands": [
    {
      "name": "config",
      "description": "Dotfiles (~/.config)",
      "keywords": ["config", "dotfiles"],
      "workspace": {
        "name": "config",
        "cwd": "~/.config",
        "color": "#3E4B5E",
        "restart": "ignore"
      }
    },
    {
      "name": "claude",
      "description": "Claude config (~/.claude)",
      "keywords": ["claude", "agent"],
      "workspace": {
        "name": "claude",
        "cwd": "~/.claude",
        "color": "#6A1B9A",
        "restart": "ignore"
      }
    },
    {
      "name": "january",
      "description": "January monorepo root",
      "keywords": ["jan", "monorepo"],
      "workspace": {
        "name": "january",
        "cwd": "~/code/january",
        "color": "#1565C0",
        "restart": "ignore"
      }
    },
    {
      "name": "AgentPortal",
      "description": "January frontend AgentPortal",
      "keywords": ["ap", "portal", "frontend"],
      "workspace": {
        "name": "AgentPortal",
        "cwd": "~/code/january/frontend/AgentPortal",
        "color": "#006B6B",
        "restart": "ignore"
      }
    },
    {
      "name": "debtsy",
      "description": "January backend debtsy app",
      "keywords": ["dbt", "backend"],
      "workspace": {
        "name": "debtsy",
        "cwd": "~/code/january/src/apps/debtsy",
        "color": "#196F3D",
        "restart": "ignore"
      }
    }
  ],
  "shortcuts": {
    "bindings": {
      "commandPalette": "ctrl+f"
    }
  }
}
